<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-700 min-h-screen flex justify-center items-start p-10">

    <div class="w-full max-w-4xl bg-zinc-900 shadow-xl rounded-xl p-8">

        <!-- Back Button -->
        <a 
          href="/" 
          class="inline-block mb-6 bg-zinc-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 shadow-md"
        >
          ← Back to Home
        </a>

        <form action="/edit" method="post" class="space-y-4 mb-10">

            <input 
                type="text" 
                name="previous"
                placeholder="Previous Name"
                value="<%=filename%>"
                
                class="block w-1/4 bg-zinc-700 text-zinc-5  00 text-white border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-gray-400 "
            >

          <input 
                type="new" 
                name="new"
                placeholder="new Name"
                
                class="block w-1/4 bg-zinc-700 text-white border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-gray-400"
            >

             

            <button 
                type="submit"
                class="bg-yellow-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition duration-200 shadow-md"
            >
                update now
            </button>

        </form>

    </div>

</body>
</html>