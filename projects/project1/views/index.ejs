<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900 min-h-screen flex justify-center items-start p-10">

    <div class="w-full max-w-4xl bg-zinc-800 shadow-xl rounded-xl p-8">

        <!-- Heading -->
        <h1 class="text-3xl font-bold text-center text-white mb-8">
            Simple Task Manager
        </h1>

        <!-- Form -->
        <form action="/create" method="post" class="space-y-4 mb-10">

            <input 
                type="text" 
                name="title"
                placeholder="Title goes here"
                required
                class="w-full bg-zinc-700 text-white border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-gray-400"
            >

            <textarea 
                name="details"
                placeholder="Write your task here"
                required
                rows="3"
                class="w-full bg-zinc-700 text-white border border-slate-600 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder-gray-400"
            ></textarea>

            <button 
                type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition duration-200 shadow-md"
            >
                Create Task
            </button>

        </form>

        <!-- Tasks Section -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <% if (files.length > 0) { %>

                <% files.forEach(function(val){ %>

                    <div class="bg-zinc-700 p-5 rounded-lg shadow hover:shadow-lg transition duration-200">

                        <h2 class="text-xl font-semibold text-white mb-2">
                            <%= val %>
                        </h2>
                        <div class="flex justify-between items-center">
                            <a 
                            href="/file/<%= val %>"
                            class="text-blue-400 hover:text-blue-300 text-sm transition"
                        >
                            Read More →
                        </a>
                        <a href="/edit/<%=val%>">edit this file</a>
                        </div>
                        

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-span-full text-center text-gray-400">
                    <h3>No tasks yet.</h3>
                </div>

            <% } %>

        </div>

    </div>

</body>
</html>