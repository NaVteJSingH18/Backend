<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create User</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900 flex items-center justify-center min-h-screen text-white">

    <div class="bg-zinc-800 p-8 rounded-xl w-[400px] shadow-lg">

        <div class="mb-6">
            <a href="/read" class="text-blue-400 hover:underline">Read Users</a>
        </div>

        <h1 class="text-2xl font-semibold mb-6">Edit User</h1>

        <form action="/update/<%=user._id%>" method="post" class="flex flex-col gap-4">

            <input 
            type="text" 
            placeholder="Name" 
            value="<%=user.name%>"
            name="name"
            class="bg-zinc-700 p-3 rounded-md outline-none focus:ring-2 focus:ring-blue-500"
            >

            <input 
            type="text" 
            placeholder="Email" 
            value="<%=user.email%>"
            name="email"
            class="bg-zinc-700 p-3 rounded-md outline-none focus:ring-2 focus:ring-blue-500"
            >

            <input 
            type="text" 
            placeholder="Image URL"  
            value="<%=user.image%>"
            name="image"
            class="bg-zinc-700 p-3 rounded-md outline-none focus:ring-2 focus:ring-blue-500"
            >

            <input 
            type="submit" 
            value="Edit User"
            class="bg-yellow-500 hover:bg-blue-600 transition p-3 rounded-md font-semibold cursor-pointer"
            >

        </form>

    </div>

</body>
</html>