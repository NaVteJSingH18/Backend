<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-700 min-h-screen flex justify-center items-start p-10">

    <div class="w-full max-w-4xl bg-zinc-900 shadow-xl rounded-xl p-8">

        <!-- Back Button -->
        <a 
          href="/" 
          class="inline-block mb-6 bg-zinc-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 shadow-md"
        >
          ← Back to Home
        </a>

        <!-- Title -->
        <h1 class="text-3xl font-bold text-center text-white mb-8">
            <%= filename %>
        </h1>

        <!-- File Content -->
        <div class="bg-zinc-700 p-6 rounded-lg shadow-inner">
            <p class="text-zinc-300 leading-relaxed whitespace-pre-line">
                <%= filedata %>
            </p>
        </div>

    </div>

</body>
</html>